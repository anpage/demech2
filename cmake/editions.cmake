# The simulator editions' features for the assembly. util/types.h maps each edition macro
# (MW2_ACCEL, MW2_MATROX, MW2_3DFX) to the features it has, one #define each, and the C reads
# them from there; ML can't read a C header, so it gets the same features as /D options, read
# from the same table. Expects DEMECH2_SOURCE_DIR.

# Sets OUT to the ML options for an edition: /D of each edition macro given and of every feature
# util/types.h defines under one of them that the assembly tests (IFDEF or IFNDEF), /DNAME=VALUE for a
# value feature. Only those: all of them would take ML's command line past what NMAKE accepts.
function(demech2_edition_masm_defines out)
  file(GLOB_RECURSE assembly "${DEMECH2_SOURCE_DIR}/3rdparty/vfx/*.ASM" "${DEMECH2_SOURCE_DIR}/3rdparty/vfx/*.INC"
    "${DEMECH2_SOURCE_DIR}/MW2/src/*.asm")
  set(tested "")
  foreach(file IN LISTS assembly)
    file(STRINGS "${file}" tests REGEX "^[ \t]*(IFDEF|IFNDEF|ELSEIFDEF|ELSEIFNDEF)[ \t]+MW2_")
    foreach(test IN LISTS tests)
      string(REGEX REPLACE "^[ \t]*[A-Z]+[ \t]+(MW2_[A-Za-z0-9_]+).*" "\\1" name "${test}")
      list(APPEND tested "${name}")
    endforeach()
  endforeach()
  file(STRINGS "${DEMECH2_SOURCE_DIR}/util/types.h" lines REGEX "^[ \t]*#[ \t]*(if|ifdef|ifndef|endif|define)")
  set(options "")
  foreach(edition IN LISTS ARGN)
    list(APPEND options "/D${edition}")
  endforeach()
  set(depth 0)
  set(edition_depth 0)
  set(active FALSE)
  foreach(line IN LISTS lines)
    if(line MATCHES "^[ \t]*#[ \t]*(ifdef|ifndef|if)([^A-Za-z0-9_]|$)")
      math(EXPR depth "${depth} + 1")
      if(line MATCHES "^[ \t]*#[ \t]*ifdef[ \t]+(MW2_ACCEL|MW2_MATROX|MW2_3DFX)[ \t]*$")
        set(edition_depth ${depth})
        list(FIND ARGN "${CMAKE_MATCH_1}" found)
        if(found EQUAL -1)
          set(active FALSE)
        else()
          set(active TRUE)
        endif()
      endif()
    elseif(line MATCHES "^[ \t]*#[ \t]*endif")
      if(depth EQUAL edition_depth)
        set(edition_depth 0)
        set(active FALSE)
      endif()
      math(EXPR depth "${depth} - 1")
    elseif(active AND line MATCHES "^[ \t]*#[ \t]*define[ \t]+(MW2_[A-Za-z0-9_]+)([ \t]+([0-9]+))?")
      set(name "${CMAKE_MATCH_1}")
      set(value "${CMAKE_MATCH_3}")
      list(FIND tested "${name}" used)
      if(NOT used EQUAL -1 AND value)
        list(APPEND options "/D${name}=${value}")
      elseif(NOT used EQUAL -1)
        list(APPEND options "/D${name}")
      endif()
    endif()
  endforeach()
  set(${out} "${options}" PARENT_SCOPE)
endfunction()
