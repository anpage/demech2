; Import library for ATI3DCIF.DLL (ATI's 3D Rage Common Interface, the 3D CIF): the functions the
; ATI edition imports. The original imports the __stdcall-decorated names (_ATI3DCIF_Init@0 ...);
; LIB takes the decorations from ati3dcif.c.
LIBRARY ati3dcif
EXPORTS
    _ATI3DCIF_ContextCreate@0
    _ATI3DCIF_ContextDestroy@4
    _ATI3DCIF_ContextSetState@12
    _ATI3DCIF_Init@0
    _ATI3DCIF_RenderBegin@4
    _ATI3DCIF_RenderEnd@0
    _ATI3DCIF_RenderPrimList@8
    _ATI3DCIF_RenderPrimStrip@8
    _ATI3DCIF_Term@0
    _ATI3DCIF_TextureReg@8
    _ATI3DCIF_TextureUnreg@4
