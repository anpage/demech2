; Import library for SGL.DLL (VideoLogic's PowerVR SGL, its scene graph library): the functions the
; PowerVR edition imports, by name (__cdecl, undecorated).
LIBRARY sgl
EXPORTS
    sgl_add_face
    sgl_add_plane
    sgl_add_vertices
    sgl_attach_list
    sgl_create_ambient_light
    sgl_create_cached_texture
    sgl_create_camera
    sgl_create_convex
    sgl_create_detail_levels
    sgl_create_list
    sgl_create_material
    sgl_create_mesh
    sgl_create_parallel_light
    sgl_create_screen_device
    sgl_create_texture
    sgl_create_transform
    sgl_create_viewport
    sgl_delete_device
    sgl_delete_face
    sgl_delete_list
    sgl_delete_texture
    sgl_detach_list
    sgl_get_device
    sgl_get_errors
    sgl_get_free_texture_mem
    sgl_get_viewport
    sgl_load_cached_texture
    sgl_modify_convex
    sgl_modify_list
    sgl_modify_material
    sgl_modify_transform
    sgl_new_translucent
    sgl_num_faces
    sgl_qual_fog
    sgl_qual_generate_shadows
    sgl_qual_smooth_shading
    sgl_qual_texturing
    sgl_register_texture_callback
    sgl_render
    sgl_rotate
    sgl_set_ambient
    sgl_set_ambient_light
    sgl_set_background_colour
    sgl_set_camera
    sgl_set_cull_mode
    sgl_set_diffuse
    sgl_set_fog
    sgl_set_glow
    sgl_set_ignore_list
    sgl_set_opacity
    sgl_set_parallel_light
    sgl_set_plane
    sgl_set_texture_effect
    sgl_set_texture_map
    sgl_set_viewport
    sgl_subtract_viewport
    sgl_texture_size
    sgl_to_parent
    sgl_translate
    sgl_unload_cached_texture
    sgl_use_ddraw_mode
    sgl_use_instance
    sgl_use_material_instance
