    ICON            104,104,3,2,18,20
    CTEXT           "NetMech for Windows\xae 95",IDC_STATIC,20,4,96,8
    CONTROL         "",2008,"Edit",ES_LEFT | ES_MULTILINE | ES_READONLY | WS_VSCROLL | WS_BORDER,7,25,225,101
END

