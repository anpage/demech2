// NETMECHW.DLL resources: the lobby's dialogs, string tables and version block, recovered
// from the original binary; RC 2.2 compiles each resource byte-identical to the original's.
// Resource and control IDs stay numeric until their names are known. The resources are
// listed in the original's data order.
//
// The icons (groups 104 and 105) and the 18 bitmaps are not in the repository: the build
// extracts them from the original NETMECHW.DLL and defines DEMECH2_ORIGINAL_IMAGES. Without
// them the lobby has no icons or pictures.

#include <windows.h>
#include <commctrl.h>

// The resource editor's ID for controls the code never addresses (MFC's winres.h has it)
#define IDC_STATIC (-1)

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

ABOUTBOX DIALOG DISCARDABLE  22, 17, 240, 161
STYLE DS_SETFONT | DS_MODALFRAME | WS_CAPTION | WS_SYSMENU
CAPTION "The Keshik"
FONT 8, "System"
BEGIN
